# Copier ce fichier vers .env.production, puis remplacer toutes les valeurs CHANGE_ME.
# Ne jamais committer .env.production ni les certificats privés.

ENVIRONMENT=production
DEBUG=false
POSTGRES_USER=pgcc_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=pgcc_prod
DATABASE_URL=postgresql+asyncpg://pgcc_user:CHANGE_ME_DB_PASSWORD@postgres:5432/pgcc_prod

JWT_ALGORITHM=HS256
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_64_RANDOM_CHARACTERS
MFA_ENCRYPTION_KEYS=CHANGE_ME_GENERATE_A_FERNET_KEY
AUTH_RATE_LIMIT_HMAC_KEY=CHANGE_ME_GENERATE_AT_LEAST_48_RANDOM_CHARACTERS
PARSER_SHARED_TOKEN=CHANGE_ME_GENERATE_AT_LEAST_48_RANDOM_CHARACTERS

CORS_ORIGINS=https://pgcc.example.com
AUTH_TRUSTED_PROXY_IPS=172.31.10.10/32
