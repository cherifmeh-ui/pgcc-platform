# .env.example
# Copier en .env et remplir. NE JAMAIS committer le .env réel.

APP_NAME=PGCC
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# PostgreSQL
POSTGRES_USER=pgcc_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ctf_grc_db

# JWT (validation stricte en Phase 1)
JWT_ALGORITHM=HS256
JWT_SECRET=CHANGE_ME_WITH_PYTHON_SECRETS_TOKEN_HEX_64
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PRE_AUTH_TOKEN_EXPIRE_MINUTES=5
CHANGE_PASSWORD_TOKEN_EXPIRE_MINUTES=10

# MFA
MFA_ISSUER_NAME=CTF PGCC
MFA_VALID_WINDOW=1
# Optional in development (derived from JWT_SECRET); required in staging/production.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEYS=

# Login security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Optional in development (derived from JWT_SECRET); required in staging/production.
AUTH_RATE_LIMIT_HMAC_KEY=
# Comma-separated trusted proxy IPs/CIDRs; blank means ignore X-Forwarded-For.
AUTH_TRUSTED_PROXY_IPS=

# Antivirus documentaire (ClamAV / clamd INSTREAM)
# Configurez le nom DNS/IP du daemon. Upload refusé si le scanner est absent.
# Obligatoire en staging/production ; aucun scan simulé n’est accepté.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://pgcc.ctf.com.tn

# IA - Ollama (activée en Phase 6)
AI_ENABLED=false
AI_PROVIDER=none
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_FALLBACK_MODEL=phi3:latest
OLLAMA_TIMEOUT_SECONDS=60